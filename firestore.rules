rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: letters
    // Document ID: auto-generated
    // Fields:
    //   - content: string (required) - The letter text
    //   - design: map (required) - Design configuration
    //   - flower: string (optional) - Base64 flower image
    //   - recipient: string (optional) - Recipient name
    //   - uid: string (required) - Author UID
    //   - createdAt: timestamp (required) - Creation time
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "olugbemiopedepo@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidLetter(data) {
      return data.content is string && data.content.size() > 0 && data.content.size() < 10000 &&
             data.design is map &&
             (!('flower' in data) || (data.flower is string && data.flower.size() < 2000000)) &&
             (!('recipient' in data) || (data.recipient is string && data.recipient.size() < 100)) &&
             data.uid is string &&
             data.createdAt is timestamp;
    }

    match /letters/{letterId} {
      // Public read access for shared links
      allow read: if true;
      
      allow create: if isAuthenticated() && 
                      isValidLetter(request.resource.data) && 
                      request.resource.data.uid == request.auth.uid;
      
      allow update, delete: if isOwner(resource.data.uid) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
